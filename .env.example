# Copy to .env (never commit .env)
DATA_DIR=sample-data
# Several datasets: separate with ; on Windows or : on Linux/macOS
DB_PATH=data/asset.db
RULES_PATH=rules/rules.json
TODAY=2026-10-17

# LLM provider: gemini | openrouter | ollama
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=gemma-4-31b-it
OLLAMA_BASE_URL=http://localhost:11434/v1

# Ollama: build the 16k-context variant first (see README), then:
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma4-31b-ctx
